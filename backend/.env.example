PORT=5000
JWT_SECRET=change-this-long-random-secret
FRONTEND_URL=https://new-project-two-eta-97.vercel.app
# Postgres (Neon). REQUIRED in production - without it data is saved to a local file that is wiped on restart.
DATABASE_URL=
# Admin login mobile number (10 digit). Login with OTP -> gets admin panel.
ADMIN_PHONE=9999999999
# OTP mode: "dev" = fixed OTP 123456 (testing). "firebase" = verify Firebase ID token from frontend.
OTP_MODE=dev
FIREBASE_API_KEY=
# Razorpay (leave empty => mock payment mode for testing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# WhatsApp Cloud API lead alerts (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: login OTP over WhatsApp (needs an approved AUTHENTICATION template in Meta)
# OTP_MODE=whatsapp
# WHATSAPP_OTP_TEMPLATE=
# WHATSAPP_OTP_LANG=en
# Optional pricing
# CATEGORY_BANNER_PRICE_PER_DAY=149

# ---- Email (Gmail SMTP: pvrshub@gmail.com) ----
# 1) Google Account -> Security -> turn ON 2-Step Verification
# 2) Google Account -> Security -> App passwords -> create one named "PVRS HUB" -> copy the 16-letter code
# 3) Put that code in SMTP_PASS (NOT your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=pvrshub@gmail.com
SMTP_PASS=
MAIL_FROM="PVRS HUB <pvrshub@gmail.com>"
# Admin alerts (new listing / grievance / report) are emailed here
ADMIN_EMAIL=pvrshub@gmail.com

# Pricing (INR)
PREMIUM_PLAN_PRICE=2999
PREMIUM_PLAN_DAYS=365
BANNER_PRICE_PER_DAY=199
